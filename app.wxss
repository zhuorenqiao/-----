/* 全局样式 - 家常菜餐厅点餐小程序 · 墨色留白 */
page {
  /* 至少占满视口；不用固定 height:100%，否则内容超高时页面无法滚动 */
  min-height: 100%;

  /* 操作色：朱赭 / 点睛色：朱赭 */
  --ink: #211E1A;
  --primary: #E8590C;
  --primary-press: #C74A08;
  --accent: #E8590C;
  --accent-bg: #FCEDE3;
  --primary-bg: #FCEDE3;
  --gold: #B98A2F;
  --text-main: #26221C;
  --text-sub: #8A8478;
  --text-light: #B9B1A4;
  --bg-page: #F7F5F0;
  --bg-card: #FFFFFF;
  --bg-wash: #F1EDE5;
  --line: #ECE7DD;
  --green: #4E7A58;
  --red: #C0432F;

  /* 展示字体：与正文同一字体栈，保证没有微软雅黑的设备上标题与正文视觉统一 */
  --font-display: 'Microsoft YaHei', 'PingFang SC', 'Hiragino Sans GB', -apple-system, BlinkMacSystemFont, sans-serif;

  background: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: 'Microsoft YaHei', 'PingFang SC', 'Hiragino Sans GB', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 表单类内置组件不继承 page 字体，显式统一 */
button,
input,
textarea,
picker {
  font-family: 'Microsoft YaHei', 'PingFang SC', 'Hiragino Sans GB', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ---------- 通用容器 ---------- */
.page {
  min-height: 100%;
  box-sizing: border-box;
  /* 建立 BFC，阻止首/尾子元素的 margin 塌陷穿透容器，避免内容不满一屏也能滚动 */
  display: flow-root;
}

.section {
  background: var(--bg-card);
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
}
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title .t {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
}
.section-title .more .arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--text-light);
  border-right: 3rpx solid var(--text-light);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 80rpx;
  height: 80rpx;
  transition: opacity .2s ease-out;
}
.btn-primary {
  background: var(--ink);
  color: #fff;
}
.btn-primary[disabled] {
  background: #E8C6B2;
  color: #fff;
}
.btn-ghost {
  background: var(--accent-bg);
  color: var(--accent);
}
.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  line-height: 76rpx;
  height: 76rpx;
}
.btn-block {
  display: block;
  width: 100%;
}
.btn::after { border: none; }

/* ---------- 价格 / 标签 ---------- */
.price {
  color: var(--accent);
  font-weight: 600;
}
.price .sym { font-size: 22rpx; }
.price .int {
  font-size: 36rpx;
  font-family: var(--font-display);
}
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--accent-bg);
  color: var(--accent);
  margin-right: 10rpx;
}
.tag-gray { background: var(--bg-wash); color: var(--text-sub); }
.tag-green { background: #EAF1EB; color: var(--green); }
.tag-red { background: #F8EAE6; color: var(--red); }

/* ---------- 布局工具 ---------- */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.text-sub { color: var(--text-sub); font-size: 24rpx; }
.text-light { color: var(--text-light); font-size: 22rpx; }

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty image { width: 220rpx; height: 220rpx; margin-bottom: 24rpx; opacity: .8; }
.empty .tip { color: var(--text-light); font-size: 26rpx; }

/* ---------- 表单 ---------- */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.form-item:last-child { border-bottom: none; }
.form-item .label { width: 150rpx; font-size: 28rpx; color: var(--text-sub); }
.form-item input, .form-item textarea, .form-item picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}
