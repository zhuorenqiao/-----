/* 全局样式 - 家常菜餐厅点餐小程序 */
page {
  --primary: #E8590C;
  --primary-press: #C74808;
  --primary-bg: #FEF1E7;
  --gold: #F5A623;
  --text-main: #2B2620;
  --text-sub: #8A8175;
  --text-light: #B4AC9F;
  --bg-page: #F6F3EE;
  --bg-card: #FFFFFF;
  --line: #EFEAE2;
  --green: #2FA84F;
  --red: #D93025;

  background: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用容器 ---------- */
.page {
  min-height: 100vh;
  box-sizing: border-box;
}
.section {
  background: var(--bg-card);
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title .t {
  font-size: 32rpx;
  font-weight: 600;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
}
.section-title .more .arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--text-light);
  border-right: 3rpx solid var(--text-light);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 80rpx;
  height: 80rpx;
}
.btn-primary {
  background: var(--primary);
  color: #fff;
}
.btn-primary[disabled] {
  background: #F3C3A6;
  color: #fff;
}
.btn-ghost {
  background: var(--primary-bg);
  color: var(--primary);
}
.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  line-height: 76rpx;
  height: 76rpx;
}
.btn-block {
  display: block;
  width: 100%;
}
.btn::after { border: none; }

/* ---------- 价格 / 标签 ---------- */
.price {
  color: var(--primary);
  font-weight: 600;
}
.price .sym { font-size: 22rpx; }
.price .int { font-size: 36rpx; }
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--primary-bg);
  color: var(--primary);
  margin-right: 10rpx;
}
.tag-gray { background: #F2EFE9; color: var(--text-sub); }
.tag-green { background: #E9F7EE; color: var(--green); }
.tag-red { background: #FDECEA; color: var(--red); }

/* ---------- 布局工具 ---------- */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.text-sub { color: var(--text-sub); font-size: 24rpx; }
.text-light { color: var(--text-light); font-size: 22rpx; }

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty image { width: 220rpx; height: 220rpx; margin-bottom: 24rpx; }
.empty .tip { color: var(--text-light); font-size: 26rpx; }

/* ---------- 表单 ---------- */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.form-item:last-child { border-bottom: none; }
.form-item .label { width: 150rpx; font-size: 28rpx; color: var(--text-sub); }
.form-item input, .form-item textarea, .form-item picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}
