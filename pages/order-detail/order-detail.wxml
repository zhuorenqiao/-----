<wxs src="../../utils/money.wxs" module="fmt" />

<view class="page order-detail-page" wx:if="{{order}}">
  <!-- 状态头部 -->
  <view class="status-header">
    <view class="status-icon">
      <image src="/assets/icons/check.png" mode="aspectFit" />
    </view>
    <view class="status-text">
      <view class="s-title">{{statusText}}</view>
      <view class="s-desc">{{statusDesc}}</view>
    </view>
  </view>

  <!-- 菜品清单 -->
  <view class="section">
    <view class="section-title"><text class="t">菜品清单</text></view>
    <view class="detail-item" wx:for="{{order.items}}" wx:key="id">
      <image class="item-img" src="{{item.image_url}}" mode="aspectFill" />
      <view class="item-info">
        <view class="item-name ellipsis">{{item.name}}</view>
        <view class="item-sub">¥{{item.priceText}} × {{item.quantity}}</view>
      </view>
      <view class="item-sum">¥{{item.subtotalText}}</view>
    </view>
    <view class="total-row">
      <text class="total-label">合计</text>
      <text class="total-value">¥{{totalText}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="section-title"><text class="t">订单信息</text></view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{orderNoText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{timeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付方式</text>
      <text class="info-value">餐后到店支付</text>
    </view>
    <view class="info-row">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark || '无'}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-row" wx:if="{{order.status === 'pending'}}">
    <view class="action-btn btn-cancel" hover-class="btn-hover" bindtap="onCancel">取消订单</view>
    <view class="action-btn btn-confirm" hover-class="btn-hover" bindtap="onComplete">确认完成</view>
  </view>
  <view class="action-row" wx:elif="{{order.status === 'completed' || order.status === 'cancelled'}}">
    <view class="action-btn btn-reorder" hover-class="btn-hover" bindtap="onReorder">再来一单</view>
  </view>
</view>
