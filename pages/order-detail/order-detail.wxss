.order-detail-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 状态头部 ---------- */
.status-header {
  background: linear-gradient(160deg, #F0854A 0%, #E8590C 70%);
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
}

.status-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.status-icon image {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.s-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.s-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ---------- 菜品清单 ---------- */
.detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.detail-item:last-of-type {
  border-bottom: none;
}

.item-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F4F0E9;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
}

.item-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.item-sum {
  font-size: 28rpx;
  font-weight: 600;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.total-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

/* ---------- 订单信息 ---------- */
.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-main);
  text-align: right;
  max-width: 60%;
}

/* ---------- 操作按钮 ---------- */
.action-row {
  display: flex;
  padding: 24rpx 24rpx 0;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-cancel {
  background: #F2EFE9;
  color: var(--text-sub);
  margin-right: 20rpx;
}

.btn-confirm {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-reorder {
  background: var(--primary-bg);
  color: var(--primary);
}

.btn-hover {
  opacity: 0.9;
}
