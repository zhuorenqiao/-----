.admin-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 统计 ---------- */
.stats-row {
  display: flex;
  padding: 24rpx 24rpx 0;
}

.stat-card {
  flex: 1;
  margin-right: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

/* ---------- 云端快捷操作 ---------- */
.cloud-actions {
  padding: 20rpx 24rpx 0;
}

.cloud-btn {
  height: 76rpx;
  border-radius: 12rpx;
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover { opacity: 0.85; }

/* ---------- 分段切换 ---------- */
.seg-bar {
  display: flex;
  margin: 24rpx 24rpx 0;
  background: #EDE8DF;
  border-radius: 12rpx;
  padding: 6rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 8rpx;
}

.seg-active {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
}

/* ---------- 工具栏 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.toolbar-title {
  font-size: 28rpx;
  font-weight: 600;
}

.add-btn {
  display: flex;
  align-items: center;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.a-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  filter: brightness(0) invert(1);
}

/* ---------- 列表 ---------- */
.admin-list {
  padding: 8rpx 28rpx;
}

.admin-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.admin-item:last-child {
  border-bottom: none;
}

.a-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F4F0E9;
}

.a-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.a-name {
  font-size: 28rpx;
  font-weight: 500;
}

.a-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.a-cat {
  font-size: 20rpx;
  color: var(--text-sub);
  background: #F2EFE9;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}

.a-price {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.a-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.a-btns {
  display: flex;
  margin-top: 10rpx;
}

.a-btn {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.a-btn image {
  width: 60rpx;
  height: 60rpx;
}

/* ---------- 分类行 ---------- */
.cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cat-row:last-child {
  border-bottom: none;
}

.c-name {
  font-size: 28rpx;
}

.c-actions {
  display: flex;
  align-items: center;
}
