.bottom-space {
  /* 预留自定义 tabBar 高度 + 底部安全区，避免尾部内容被遮挡 */
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部：留白 + 衬线字标 ---------- */
.header {
  padding: 48rpx 32rpx 40rpx;
}

.brand {
  display: flex;
  align-items: center;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
}

.brand-text {
  margin-left: 24rpx;
}

.brand-text .name {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 6rpx;
}

.brand-text .slogan {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  letter-spacing: 3rpx;
}

.header-info {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.info-item text {
  font-size: 22rpx;
  color: var(--text-sub);
}

.i-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  filter: brightness(0);
  opacity: 0.5;
}

/* ---------- 今日推荐 ---------- */
.recommend {
  display: flex;
  padding: 0;
  overflow: hidden;
}

.rec-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.rec-info {
  flex: 1;
  min-width: 0;
  padding: 28rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.rec-tag {
  align-self: flex-start;
  font-size: 20rpx;
  color: var(--accent);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.rec-name {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.rec-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.rec-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--primary);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

/* ---------- 分类网格 ---------- */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.cat-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 10rpx;
}

.cat-name {
  font-size: 24rpx;
  color: var(--text-main);
  max-width: 100%;
}

/* ---------- 菜品网格 ---------- */
.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* ---------- 本地模式提示 ---------- */
.local-tip {
  padding: 20rpx 24rpx;
}

.tip-text {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.6;
}
