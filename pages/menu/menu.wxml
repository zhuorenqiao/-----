<view class="page menu-page">
  <view class="menu-body">
    <!-- 左侧分类 -->
    <scroll-view class="cat-side" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-item {{item.active ? 'cat-active' : ''}}"
        bindtap="onCatTap"
        data-id="{{item.id}}"
      >
        <text class="cat-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-side" scroll-y>
      <view class="dish-wrap">
        <view class="cat-title">{{activeCategoryName}}</view>
        <block wx:if="{{dishes.length > 0}}">
          <dish-card
            wx:for="{{dishes}}"
            wx:key="id"
            dish="{{item}}"
            quantity="{{quantities[item.id] || 0}}"
            layout="list"
            bind:tap="onDishTap"
            bind:change="onDishChange"
          />
        </block>
        <view wx:else class="no-dish">
          <text>该分类下暂无菜品</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <cart-bar
    wx:if="{{cartCount > 0}}"
    count="{{cartCount}}"
    total="{{cartTotal}}"
    button-text="去结算"
    bind:cart="onCartTap"
    bind:checkout="onCheckout"
  />
</view>
