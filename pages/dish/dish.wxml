<wxs src="../../utils/money.wxs" module="fmt" />

<view class="page dish-page" wx:if="{{dish}}">
  <view class="hero">
    <image class="hero-img" src="{{dish.image_url}}" mode="aspectFill" bindtap="onPreviewImage" />
  </view>

  <view class="info-card">
    <view class="name-row">
      <text class="dish-name">{{dish.name}}</text>
      <text wx:if="{{dish.featured}}" class="featured-tag">招牌推荐</text>
      <text wx:if="{{dish.baby}}" class="baby-tag">宝宝营养餐</text>
    </view>
    <view class="price-row">
      <view class="price">
        <text class="sym">¥</text><text class="num">{{fmt.money(dish.price)}}</text>
      </view>
      <view class="meta">
        <text wx:if="{{categoryName}}" class="meta-tag">{{categoryName}}</text>
        <text class="meta-sales">月售 {{dish.sales || 0}}</text>
      </view>
    </view>
    <view class="desc-block">
      <view class="desc-title">菜品介绍</view>
      <view class="desc-text">{{dish.description || '主厨精心烹制，选用新鲜食材。'}}</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="cart-entry {{cartBump ? 'cart-bump' : ''}}" bindtap="onCartTap">
      <image class="bag-icon" src="/assets/icons/bag-small.png" mode="aspectFit" />
      <view wx:if="{{quantity > 0}}" class="cart-badge">{{quantity}}</view>
    </view>
    <view class="action-btns">
      <view class="btn-add" hover-class="btn-hover" bindtap="onAddCart">加入购物车</view>
      <view class="btn-buy" hover-class="btn-hover" bindtap="onBuyNow">立即购买</view>
    </view>
  </view>

  <!-- 抛物线飞入购物车动画 -->
  <fly-ball id="flyBall" />
</view>
