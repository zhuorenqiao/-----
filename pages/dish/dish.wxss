.dish-page {
  min-height: 100%;
  padding-bottom: 140rpx;
  background: var(--bg-page);
}

.hero {
  width: 100%;
  height: 560rpx;
  background: #F4F0E9;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.info-card {
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -24rpx;
  position: relative;
  padding: 32rpx 28rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.dish-name {
  font-size: 40rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.featured-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F5A623, #E8590C);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.baby-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9EBB, #F2668F);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.price-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price .sym {
  font-size: 26rpx;
}

.price .num {
  font-size: 48rpx;
  font-weight: 700;
}

.meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin-right: 14rpx;
}

.meta-sales {
  font-size: 22rpx;
  color: var(--text-light);
}

.desc-block {
  margin-top: 32rpx;
  border-top: 2rpx solid var(--line);
  padding-top: 28rpx;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.desc-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(43, 38, 32, 0.08);
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  /* 高于已选菜品弹层遮罩(120)，作为弹层底栏时保持常亮可点 */
  z-index: 140;
}

/* 弹层打开时与白色面板无缝拼接 */
.action-flat {
  box-shadow: none;
}

.cart-entry {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.bag-icon {
  width: 52rpx;
  height: 52rpx;
  filter: brightness(0) saturate(100%) invert(43%) sepia(92%) saturate(2400%) hue-rotate(357deg) brightness(92%) contrast(94%);
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E5484D;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-btns {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

/* 价格行右侧的加购按钮与底栏购买按钮：等宽胶囊 */
.btn-add,
.btn-buy {
  flex-shrink: 0;
  width: 204rpx;
  height: 68rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 数量步进器占位：与加购按钮同宽右对齐，避免切换时价格行跳动 */
.stepper-slot {
  flex-shrink: 0;
  width: 204rpx;
  margin-left: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-add {
  margin-left: 20rpx;
  background: var(--primary-bg);
  color: var(--primary);
}

.btn-buy {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-hover {
  opacity: 0.9;
}

/* 落袋后购物车图标的弹跳反馈 */
.cart-bump {
  animation: cart-bump 0.45s ease;
}

@keyframes cart-bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.25); }
  100% { transform: scale(1); }
}
