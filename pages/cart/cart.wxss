.cart-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-light);
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cart-item:last-child {
  border-bottom: none;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F4F0E9;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
}

.item-price {
  margin-top: 12rpx;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

.item-action {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn image {
  width: 36rpx;
  height: 36rpx;
}

.qty {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.invalid-tip {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #FDF6EC;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #B07D2B;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #FAF7F2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* ---------- 底部结算栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(43, 38, 32, 0.08);
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  z-index: 100;
}

.total-box {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.9;
}
