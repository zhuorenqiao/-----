.cart-page {
  min-height: 100%;
  /* 结算栏(110rpx) + 自定义tabBar(112rpx) + 安全区 */
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-light);
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cart-item:last-child {
  border-bottom: none;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F4F0E9;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
}

.item-price {
  margin-top: 12rpx;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-display);
}

.item-action {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn image {
  width: 44rpx;
  height: 44rpx;
}

.qty {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 数量加减控件 */
.qty-ctrl {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  overflow: hidden;
}

.qty-btn {
  width: 52rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-main);
}

.qty-btn-hover {
  background: var(--bg-wash);
}

.qty-num {
  min-width: 52rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-main);
}

.invalid-tip {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: var(--bg-wash);
  border-radius: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: var(--bg-wash);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* ---------- 底部结算栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  /* 抬到自定义 tabBar 上方，避免被遮挡（tabBar 已含安全区，这里不再重复计算） */
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(33, 30, 26, 0.06);
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  z-index: 100;
}

.total-box {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
  font-family: var(--font-display);
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.9;
}
