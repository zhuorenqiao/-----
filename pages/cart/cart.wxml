<wxs src="../../utils/money.wxs" module="fmt" />

<view class="page cart-page">
  <view wx:if="{{items.length > 0}}">
    <view class="section">
      <view class="section-title">
        <text class="t">已选菜品</text>
        <text class="clear-btn" bindtap="onClear">清空</text>
      </view>

      <view class="cart-item" wx:for="{{items}}" wx:key="id">
        <image class="item-img" src="{{item.image_url}}" mode="aspectFill" />
        <view class="item-info">
          <view class="item-name ellipsis">{{item.name}}</view>
          <view class="item-price">¥{{fmt.money(item.price)}}</view>
        </view>
        <view class="item-action">
          <view class="delete-btn" bindtap="onDelete" data-id="{{item.id}}">
            <image src="/assets/icons/trash.png" mode="aspectFit" />
          </view>
          <view class="qty">×{{item.quantity}}</view>
        </view>
      </view>

      <view class="invalid-tip" wx:if="{{invalidCount > 0}}">
        <text>有 {{invalidCount}} 件菜品已下架或售罄，未计入合计</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title"><text class="t">备注</text></view>
      <textarea
        class="remark-input"
        value="{{remark}}"
        placeholder="口味偏好、忌口等要求（选填）"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <empty
    wx:else
    text="购物车还是空的"
    action-text="去点餐"
    bind:action="goMenu"
  />

  <!-- 底部结算栏 -->
  <view class="bottom-bar" wx:if="{{items.length > 0}}">
    <view class="total-box">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalText}}</text>
    </view>
    <view class="submit-btn" hover-class="btn-hover" bindtap="onSubmit">提交订单</view>
  </view>
</view>
