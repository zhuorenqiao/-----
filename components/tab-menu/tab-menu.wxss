page {
  /* 固定 page 高度为实际视口，避免 100vh 在 iPad 等机型上偏大产生多余滚动 */
  height: 100%;
}

.menu-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-page);
}

.menu-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ---------- 左侧分类 ---------- */
.cat-side {
  width: 176rpx;
  height: 100%;
  background: var(--bg-wash);
}

.cat-item {
  height: 112rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cat-item .cat-name {
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
  color: var(--text-sub);
}

.cat-active {
  background: var(--bg-card);
}

.cat-active .cat-name {
  color: var(--text-main);
  font-weight: 600;
}

.cat-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 34rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--accent);
}

/* ---------- 右侧菜品 ---------- */
.dish-side {
  flex: 1;
  height: 100%;
  /* 给底部 cart-bar(112rpx) 留出空间 */
  padding-bottom: 118rpx;
  box-sizing: border-box;
}

.dish-wrap {
  padding: 4rpx 20rpx 150rpx;
}

.cat-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 1rpx;
  padding: 22rpx 6rpx 16rpx;
}

.sec-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
}
