.card {
  background: var(--bg-card);
  border-radius: 18rpx;
  overflow: hidden;
}

/* ---------- 横排（点餐列表） ---------- */
.card-list {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(43, 38, 32, 0.04);
}

.card-list .main {
  display: flex;
  min-width: 0;
}

.card-list .thumb {
  width: 208rpx;
  height: 156rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  background: var(--bg-wash);
}

.card-list .info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.card-list .name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
}

.card-list .desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.card-list .sales {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: auto;
  padding-top: 8rpx;
}

/* 价格与步进器独占一行，铺满卡片宽度 */
.card-list .bottom {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 网格（首页推荐） ---------- */
.card-grid {
  width: 100%;
  padding-bottom: 20rpx;
}

.card-grid .thumb {
  width: 100%;
  height: 330rpx;
  position: relative;
  background: var(--bg-wash);
}

.card-grid .info {
  padding: 16rpx 18rpx 0;
}

.card-grid .name {
  font-size: 28rpx;
  font-weight: 600;
}

.card-grid .desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.card-grid .sales {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.card-grid .bottom {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 通用 ---------- */
.img {
  width: 100%;
  height: 100%;
  display: block;
}

.badge {
  position: absolute;
  left: 0;
  top: 0;
  background: var(--accent);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 0 0 12rpx 0;
}

/* 宝宝营养餐标记：粉色 */
.tag-baby {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9EBB, #F2668F);
  font-size: 18rpx;
  line-height: 30rpx;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 6rpx rgba(242, 102, 143, 0.35);
}

.off-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-sub);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.price {
  display: flex;
  align-items: baseline;
  color: var(--accent);
}

.price .sym {
  font-size: 24rpx;
  font-weight: 600;
}

.price .num {
  font-size: 38rpx;
  font-weight: 600;
  font-family: var(--font-display);
  line-height: 1.1;
}

.card-grid .name {
  font-family: var(--font-display);
  letter-spacing: 1rpx;
}

.card-grid .price .num {
  font-size: 30rpx;
}
