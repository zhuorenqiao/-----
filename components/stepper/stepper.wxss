.stepper {
  display: flex;
  align-items: center;
}

.s-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.s-btn-hover {
  opacity: 0.85;
}

.s-minus {
  background: #FFFFFF;
  border: 2rpx solid #E6E0D6;
}

.s-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 图标素材为橙色，通过滤镜统一为墨/白 */
.s-plus .s-icon {
  filter: brightness(0) invert(1);
}

.s-minus .s-icon {
  filter: brightness(0);
  opacity: 0.55;
}

.s-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-main);
}

.stepper-compact .s-btn {
  width: 46rpx;
  height: 46rpx;
}

.stepper-compact .s-icon {
  width: 26rpx;
  height: 26rpx;
}

.stepper-compact .s-num {
  min-width: 48rpx;
  font-size: 26rpx;
}
