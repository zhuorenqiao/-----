.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(43, 38, 32, 0.08);
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
  z-index: 100;
}

.bar-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.cart-icon-wrap {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  width: 44rpx;
  height: 44rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: var(--red);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.total-box {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.total-price {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
}

.checkout-btn {
  width: 220rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.9;
}
