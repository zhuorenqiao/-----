.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  /* 抬到自定义 tabBar 上方，避免被遮挡（tabBar 已含安全区，这里不再重复计算） */
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  background: #FCFAF6;
  border-top: 1rpx solid rgba(43, 38, 32, 0.05);
  box-shadow: 0 -6rpx 22rpx rgba(43, 38, 32, 0.06);
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
  /* 高于已选菜品弹层(mask 120 / panel 130)，作为弹层底栏时保持常亮可点 */
  z-index: 140;
}

/* 弹层打开时：与白色面板无缝拼接 */
.bar-flat {
  background: #FFFFFF;
  border-top-color: transparent;
  box-shadow: none;
}

.bar-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.cart-icon-wrap {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 线性灰色图标统一染为主色橙 */
.cart-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) saturate(100%) invert(43%) sepia(92%) saturate(2400%) hue-rotate(357deg) brightness(92%) contrast(94%);
}

/* 飞入动画落袋时的弹跳反馈 */
.icon-bump {
  animation: icon-bump 0.5s ease;
}

@keyframes icon-bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 15rpx;
  background: #E5484D;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.total-box {
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.total-price {
  display: flex;
  align-items: baseline;
  color: var(--accent);
  line-height: 1.15;
}

.total-price .sym {
  font-size: 24rpx;
  font-weight: 600;
}

.total-price .num {
  font-size: 40rpx;
  font-weight: 600;
  font-family: var(--font-display);
}

.total-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--text-sub);
  line-height: 1.3;
}

.checkout-btn {
  flex-shrink: 0;
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F4731C 0%, #E2510A 100%);
  box-shadow: 0 6rpx 16rpx rgba(226, 81, 10, 0.24);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-hover {
  opacity: 0.9;
}
