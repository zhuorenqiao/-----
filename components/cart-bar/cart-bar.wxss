.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  /* 抬到自定义 tabBar 上方，避免被遮挡（tabBar 已含安全区，这里不再重复计算） */
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(43, 38, 32, 0.08);
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
  z-index: 100;
}

.bar-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.cart-icon-wrap {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
}

/* 飞入动画落袋时的弹跳反馈 */
.icon-bump {
  animation: icon-bump 0.5s ease;
}

@keyframes icon-bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #E5484D;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.total-box {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.total-price {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--accent);
  font-family: var(--font-display);
}

.checkout-btn {
  width: 220rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.9;
}
