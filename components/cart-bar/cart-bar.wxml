<view class="cart-bar">
  <view class="bar-left" bindtap="onCartTap">
    <view wx:if="{{showCart}}" class="cart-icon-wrap">
      <image class="cart-icon" src="/assets/icons/cart-small.png" mode="aspectFit" />
      <view wx:if="{{count > 0}}" class="badge">{{count > 99 ? '99+' : count}}</view>
    </view>
    <view class="total-box">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalText}}</text>
    </view>
  </view>
  <view class="checkout-btn" hover-class="btn-hover" bindtap="onCheckout">{{buttonText}}</view>
</view>
