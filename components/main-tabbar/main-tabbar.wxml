<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-item"
    hover-class="tab-hover"
    bindtap="onTap"
    data-index="{{index}}"
  >
    <view class="icon-wrap {{index === 2 && bump ? 'icon-bump' : ''}}">
      <image
        class="tab-icon"
        src="{{selected === index ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
      <view wx:if="{{index === 2 && cartCount > 0}}" class="tab-badge">{{cartCount}}</view>
    </view>
    <text class="tab-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</text>
  </view>
</view>
