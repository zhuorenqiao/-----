/* 自定义 tabBar：全部使用 rpx，随机型等比缩放 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  /* 固定内容区高度 112rpx，与 cart-bar 的 bottom 偏移（112rpx + 安全区）严格对齐，避免机型取整产生缝隙 */
  height: 112rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #ECE7DD;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  /* 低于 fly-ball(9999)、高于普通文档流内容；cart-bar(100) 需在其上方 */
  z-index: 90;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 12rpx;
}

.tab-hover {
  opacity: 0.7;
}

.icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 选中态图标与主色（橙）对齐 */
.tab-icon-active {
  filter: saturate(1.45) brightness(1.12) hue-rotate(-6deg);
}

/* 飞入动画落袋时的弹跳反馈 */
.icon-bump {
  animation: icon-bump 0.5s ease;
}

@keyframes icon-bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

.tab-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
